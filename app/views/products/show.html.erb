<% content_for :title, @product.name %>

<section class="product-detail">
  <div class="product-detail__heading">
    <p class="eyebrow"><%= @product.category %></p>
    <h1><%= @product.name %></h1>
    <p class="product-detail__price"><%= number_with_precision(@product.price, precision: 2) %></p>
  </div>

  <div class="product-detail__description">
    <h2>Description</h2>
    <%= simple_format(@product.description) %>
  </div>

  <section class="comments" data-controller="comment-form" aria-labelledby="comments-heading">
    <div class="comments__heading">
      <h2 id="comments-heading">Comments</h2>
      <p>Add context or feedback for this product.</p>
    </div>

    <div class="comments__list" data-comment-form-target="list">
      <%= render @comments %>
    </div>

    <%= form_with model: [@product, @comment], class: "comments__form", data: { action: "submit->comment-form#submit", comment_form_target: "form" } do |form| %>
      <div class="field">
        <%= form.label :body, "New comment" %>
        <%= form.text_area :body, rows: 4, required: true, data: { comment_form_target: "body" } %>
      </div>
      <div class="form-errors" data-comment-form-target="errors" hidden></div>
      <%= form.submit "Add comment", class: "button" %>
    <% end %>
  </section>

  <div class="page-actions">
    <%= link_to "Back to products", products_path, class: "button button--secondary" %>
    <%= render "products/purchase_modal", product: @product, order: @order %>
    <%= link_to "Edit", edit_product_path(@product), class: "button" %>
    <%= button_to "Delete", @product, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Delete this product?" } } %>
  </div>
</section>
